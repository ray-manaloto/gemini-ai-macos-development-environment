include:
  - "*.md"
  - "*.txt"
  - "*.toml"
  - "*.yaml"
  - "*.yml"
  - "*.sh"
  - "*.py"
  - "*.bats"
  - "config/**"
  - "tests/**"
  - "docs/**"
  - ".claude/**"
  - ".gemini/**"
  - ".opencode/**"
  - ".cursor/**"
exclude:
  - "node_modules/**"
  - ".git/**"
  - "*.log"
  - ".sisyphus/**"
  - "research/repos/**"
  - ".vscode/**"
  - ".zed/**"
  - ".devcontainer/**"
