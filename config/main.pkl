@ModuleInfo { minPklVersion = "0.28.0" }
module main

import "pkl:toml"

local tools: Mapping<String, String> = new {
  // Strict Hierarchy: Mise > Bun > Pixi > Uv
  // --- Core Runtimes ---
  ["bun"] = "latest"
  ["pixi"] = "latest"
  ["uv"] = "latest"
  ["chezmoi"] = "latest"
  ["usage"] = "latest"

  // --- Cloud & DevContainers ---
  ["pipx:skypilot"] = "latest"
  ["devpod"] = "latest"

  // --- Modern Rust-Based Utilities ---
  ["cargo:starship"] = "latest"
  ["cargo:ripgrep"] = "latest"
  ["cargo:fd-find"] = "latest"
  ["cargo:zoxide"] = "latest"
  ["cargo:ast-grep"] = "latest"

  // --- AI-Assisted Code Search ---
  ["uv:mgrep"] = "latest"

  // --- Infrastructure ---
  ["brew:orbstack"] = "latest"
  ["brew:infisical"] = "latest"
  ["1password-cli"] = "latest"

  // --- GUI & Utilities ---
  ["brew:swiftbar"] = "latest"
  ["brew:zed"] = "latest"
  ["pitchfork"] = "latest"

  // --- AI Agents & Tools ---
  ["npm:@anthropic-ai/claude-code"] = "latest"
  ["npm:opencode-ai"] = "latest"
  ["npm:@google/gemini-cli"] = "latest"
  ["github-cli"] = "latest"
}

local tasks: Mapping<String, Dynamic> = new {
  ["dashboard"] = new {
    description = "Launch Unified TUI"
    run = "cd ~/.config/dev-env && pixi run python config/scripts/dashboard.py"
  }
  ["validate"] = new {
    description = "Validate environment health"
    run = "sh ~/.config/dev-env/config/scripts/validate.sh"
  }
  ["help"] = new {
    description = "Show System Manual"
    run = "gum format --theme=pink < ~/.config/dev-env/MANUAL.md"
  }
  ["agent:up"] = new {
    description = "Launch Cloud Agent"
    run = "sky launch -c ai-agent ~/.config/dev-env/templates/agent.yaml --detach"
  }
  ["agent:down"] = new {
    description = "Kill Cloud Agent"
    run = "sky down ai-agent -y"
  }
  ["setup-extensions"] = new {
    description = "Install AI extensions"
    run = "gh extension install github/gh-copilot --force"
  }
  ["setup-mac"] = new {
    description = "Configure macOS defaults"
    run = "sh ~/.config/dev-env/config/scripts/macos-defaults.sh"
  }
  ["setup-mcp"] = new {
    description = "Configure mise MCP"
    run = "sh ~/.config/dev-env/config/scripts/setup-mcp.sh"
  }
}

local config: Dynamic = new {
  settings = new {
    experimental = true
    node_backend = "bun"
    pip_backend = "uv"
  }
  tools = tools
  tasks = tasks
  env = new {
    ["EDITOR"] = "zed --wait"
  }
}

output {
  text = toml.Renderer.renderDocument(config)
}
