# =============================================================================
# .zshrc - Managed by Chezmoi
# God-Tier macOS Development Environment
# =============================================================================
# DO NOT EDIT THIS FILE DIRECTLY
# Edit the template at: ~/.local/share/chezmoi/dot_zshrc.tmpl
# Then run: chezmoi apply
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Variables
# -----------------------------------------------------------------------------
export EDITOR="${EDITOR:-zed --wait}"
export VISUAL="$EDITOR"
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# -----------------------------------------------------------------------------
# Path Configuration
# -----------------------------------------------------------------------------
# User binaries (mise shims, etc.)
export PATH="$HOME/.local/bin:$PATH"

# Bun (if installed outside mise)
[ -d "$HOME/.bun" ] && export PATH="$HOME/.bun/bin:$PATH"

# -----------------------------------------------------------------------------
# Mise - Tool Version Manager (MUST BE FIRST)
# -----------------------------------------------------------------------------
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# -----------------------------------------------------------------------------
# Starship - Cross-Shell Prompt
# -----------------------------------------------------------------------------
if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

# -----------------------------------------------------------------------------
# Zoxide - Smarter cd
# -----------------------------------------------------------------------------
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# -----------------------------------------------------------------------------
# Atuin - Enhanced Shell History
# -----------------------------------------------------------------------------
if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

# -----------------------------------------------------------------------------
# Shell Options
# -----------------------------------------------------------------------------
setopt AUTO_CD              # cd by typing directory name
setopt AUTO_PUSHD           # Push directories onto stack
setopt PUSHD_IGNORE_DUPS    # Don't push duplicates
setopt PUSHD_SILENT         # Don't print stack after pushd/popd
setopt CORRECT              # Spell correction for commands
setopt EXTENDED_GLOB        # Extended globbing
setopt NO_BEEP              # No beep on error
setopt HIST_IGNORE_DUPS     # Ignore duplicate history entries
setopt HIST_IGNORE_SPACE    # Ignore commands starting with space
setopt SHARE_HISTORY        # Share history between sessions

# History configuration
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

# -----------------------------------------------------------------------------
# Aliases
# -----------------------------------------------------------------------------
# Modern replacements (if available)
command -v eza &> /dev/null && alias ls="eza --icons"
command -v bat &> /dev/null && alias cat="bat --paging=never"
command -v fd &> /dev/null && alias find="fd"

# Git shortcuts
alias g="git"
alias gs="git status"
alias gd="git diff"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline -10"

# Mise shortcuts
alias m="mise"
alias mr="mise run"
alias ml="mise ls"
alias mi="mise install"

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Safety
alias rm="rm -i"
alias mv="mv -i"
alias cp="cp -i"

# -----------------------------------------------------------------------------
# Functions
# -----------------------------------------------------------------------------

# Quick project navigation with zoxide
proj() {
  if [ -n "$1" ]; then
    z "$1" && mise install
  else
    echo "Usage: proj <project-name>"
  fi
}

# Run mise task with fuzzy finder
mrf() {
  if command -v fzf &> /dev/null; then
    local task=$(mise tasks | fzf --height 40% --reverse | awk '{print $1}')
    [ -n "$task" ] && mise run "$task"
  else
    mise tasks
  fi
}

# Show environment info
envinfo() {
  echo "=== Environment Info ==="
  echo "Shell: $SHELL"
  echo "Terminal: $TERM"
  command -v mise &> /dev/null && echo "Mise: $(mise --version)"
  command -v bun &> /dev/null && echo "Bun: $(bun --version)"
  command -v uv &> /dev/null && echo "Uv: $(uv --version 2>&1 | head -1)"
  command -v python &> /dev/null && echo "Python: $(python --version)"
  command -v node &> /dev/null && echo "Node: $(node --version)"
}

# -----------------------------------------------------------------------------
# Completions
# -----------------------------------------------------------------------------
# Initialize zsh completions
autoload -Uz compinit
compinit -C

# Mise completions
if command -v mise &> /dev/null; then
  eval "$(mise completion zsh)"
fi

# GitHub CLI completions
if command -v gh &> /dev/null; then
  eval "$(gh completion -s zsh)"
fi

# -----------------------------------------------------------------------------
# Local Overrides (not managed by chezmoi)
# -----------------------------------------------------------------------------
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# -----------------------------------------------------------------------------
# Startup Message (optional)
# -----------------------------------------------------------------------------
# Uncomment to show environment info on shell start
# envinfo
