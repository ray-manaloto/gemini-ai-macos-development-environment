# =============================================================================
# .gitconfig - Managed by Chezmoi
# God-Tier macOS Development Environment
# =============================================================================
# DO NOT EDIT THIS FILE DIRECTLY
# Edit the template at: ~/.local/share/chezmoi/dot_gitconfig.tmpl
# Then run: chezmoi apply
# =============================================================================

[user]
{{- if .name }}
	name = {{ .name }}
{{- else }}
	# TODO: Set your name with: chezmoi edit-config
	# name = Your Name
{{- end }}
{{- if .email }}
	email = {{ .email }}
{{- else }}
	# TODO: Set your email with: chezmoi edit-config
	# email = you@example.com
{{- end }}

[init]
	defaultBranch = main

[core]
	editor = zed --wait
	autocrlf = input
	whitespace = fix
	# Use delta for better diffs (if installed)
	# pager = delta

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
	algorithm = histogram

[color]
	ui = auto

[alias]
	# Status
	s = status -sb
	st = status

	# Commits
	c = commit
	cm = commit -m
	ca = commit --amend
	can = commit --amend --no-edit

	# Branches
	b = branch
	ba = branch -a
	bd = branch -d
	bD = branch -D
	co = checkout
	cob = checkout -b

	# Diffs
	d = diff
	ds = diff --staged
	dc = diff --cached

	# Logs
	l = log --oneline -10
	lg = log --graph --oneline --decorate
	ll = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

	# Stash
	ss = stash
	sp = stash pop
	sl = stash list

	# Reset
	unstage = reset HEAD --
	undo = reset --soft HEAD~1

	# Utility
	aliases = config --get-regexp alias
	contributors = shortlog -sn
	whoami = !git config user.name && git config user.email

	# AI-friendly: show recent changes for context
	recent = log --oneline -20 --no-merges
	changed = diff --name-only HEAD~1

[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else }}
	helper = store
{{- end }}

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[url "git@github.com:"]
	insteadOf = gh:

[url "git@github.com:{{ .github_user | default "YOUR_USERNAME" }}/"]
	insteadOf = my:

# =============================================================================
# Tool-specific settings
# =============================================================================

# GitHub CLI
[gh]
	gitProtocol = ssh

# Delta (if using delta as pager)
# [delta]
#     navigate = true
#     side-by-side = true
#     line-numbers = true

# =============================================================================
# Include local overrides (not managed by chezmoi)
# =============================================================================
[include]
	path = ~/.gitconfig.local
