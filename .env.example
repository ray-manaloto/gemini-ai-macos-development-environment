# .env.example - Environment Variables Template
# Copy to .env and fill in your values
# DO NOT COMMIT .env TO GIT

# =============================================================================
# AI Services
# =============================================================================

# Anthropic Claude API (for Claude Code)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API (optional)
# Get from: https://platform.openai.com
OPENAI_API_KEY=sk-...

# Google Gemini API (for Gemini CLI)
# Get from: https://ai.google.dev
# GEMINI_API_KEY is preferred, GOOGLE_API_KEY also works
GEMINI_API_KEY=...
GOOGLE_API_KEY=...

# =============================================================================
# GitHub
# =============================================================================

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Scopes needed: repo, read:org, workflow
GITHUB_TOKEN=ghp_...

# =============================================================================
# AWS (for SkyPilot Cloud Agents)
# =============================================================================

# AWS Access Key ID
# Get from: AWS IAM Console
AWS_ACCESS_KEY_ID=AKIA...

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=...

# AWS Default Region
AWS_DEFAULT_REGION=us-east-1

# AWS Profile (if using named profiles)
AWS_PROFILE=default

# =============================================================================
# Machine Learning (Optional)
# =============================================================================

# Hugging Face Token
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Weights & Biases API Key
# Get from: https://wandb.ai/authorize
WANDB_API_KEY=...

# =============================================================================
# Corporate Proxy (Optional)
# =============================================================================

# HTTP Proxy for corporate networks
# Format: http://[user:password@]proxy.company.com:port
HTTP_PROXY=
HTTPS_PROXY=

# Hosts to bypass proxy (comma-separated)
NO_PROXY=localhost,127.0.0.1,.local,.internal

# Git proxy (usually same as HTTP_PROXY)
# GIT_PROXY=

# =============================================================================
# Alternative: Use 1Password URIs
# =============================================================================
# Instead of raw values, you can use 1Password URIs in mise.toml:
#
# [env]
# ANTHROPIC_API_KEY = "op://Private/Anthropic/credential"
# AWS_ACCESS_KEY_ID = "op://Private/AWS/access_key_id"
#
# See SECRETS.md for more options.
