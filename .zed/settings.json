{
  // ==========================================================================
  // God-Tier macOS Development Environment - Zed Settings
  // ==========================================================================
  
  // UI Settings
  "theme": "One Dark",
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "buffer_font_family": "JetBrains Mono",
  
  // Editor Settings
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "none",
  "show_whitespaces": "selection",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "on",
  
  // Terminal - Use mise-activated shell
  "terminal": {
    "shell": {
      "program": "/bin/zsh"
    },
    "env": {
      "PATH": "$HOME/.local/share/mise/shims:$PATH"
    },
    "font_size": 13
  },
  
  // Git Settings
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    }
  },
  
  // Language Server Settings
  "lsp": {
    // Python - Use mise-managed Python
    "pyright": {
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    },
    
    // TypeScript - Use mise-managed Bun
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "importModuleSpecifierPreference": "relative"
        }
      }
    }
  },
  
  // Language-specific settings
  "languages": {
    "Python": {
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-"]
        }
      },
      "format_on_save": "on"
    },
    "TypeScript": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "TSX": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "JSON": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "TOML": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    },
    "Markdown": {
      "soft_wrap": "editor_width"
    },
    "Shell Script": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "2", "-"]
        }
      }
    }
  },
  
  // File associations
  "file_types": {
    "TOML": ["mise.toml", "pixi.toml", "starship.toml"],
    "Shell Script": ["*.sh", ".zshrc", ".bashrc"]
  },
  
  // Copilot Settings (if available)
  "features": {
    "copilot": true
  },
  "assistant": {
    "enabled": true,
    "button": true,
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514"
    }
  },
  
  // Project Panel
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "auto_fold_dirs": true,
    "folder_actions": true
  },
  
  // Excluded files
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
    "**/dist",
    "**/build",
    "**/.DS_Store"
  ]
}
