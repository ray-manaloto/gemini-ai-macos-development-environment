{
  "name": "God-Tier Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {
      "version": "latest",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "upgradePackages": true
    }
  },
  
  "containerEnv": {
    "MISE_TRUSTED_CONFIG_PATHS": "/workspaces",
    "MISE_YES": "1",
    "MISE_INSTALL_PATH": "/home/vscode/.local/bin/mise",
    "PATH": "/home/vscode/.local/share/mise/shims:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  
  "onCreateCommand": "cp config/mise.toml ~/.config/mise/config.toml && mise trust ~/.config/mise/config.toml && mise trust .mise.toml 2>/dev/null || true",
  "postCreateCommand": "mise run setup:container",
  "postAttachCommand": ".devcontainer/scripts/post-attach.sh",
  
  "forwardPorts": [
    3000,
    5000,
    8000,
    8080,
    8888
  ],
  
  "portsAttributes": {
    "3000": { "label": "React/Next.js", "onAutoForward": "notify" },
    "5000": { "label": "Flask", "onAutoForward": "notify" },
    "8000": { "label": "Django/FastAPI", "onAutoForward": "notify" },
    "8080": { "label": "General HTTP", "onAutoForward": "silent" },
    "8888": { "label": "Jupyter", "onAutoForward": "notify" }
  },
  
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/bin/zsh" }
        },
        "python.defaultInterpreterPath": "/home/vscode/.local/share/mise/installs/python/latest/bin/python",
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "github.copilot",
        "github.copilot-chat"
      ]
    }
  },
  
  "mounts": [
    "source=${localWorkspaceFolderBasename}-mise-data,target=/home/vscode/.local/share/mise,type=volume",
    "source=${localWorkspaceFolderBasename}-mise-config,target=/home/vscode/.config/mise,type=volume",
    "source=${localWorkspaceFolderBasename}-shell-history,target=/commandhistory,type=volume"
  ],
  
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  "privileged": false,
  
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  }
}
